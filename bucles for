using namespace std;
int main() {
    int n, x, ap, ds;
    cout << "total de cursos" << endl;
    cin >> n;
    for(int i = 1; i <= n; i++){
        cout << "nota del estudiante\n";
        cin >> x;
        if (x < 10){
            ds++;
        } else {
            ap++;
        }
    }
    cout << "aprobados: " << ap << endl;
    cout << "desaprobados: " << ds << endl;
    return 0;
}
